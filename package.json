{
  "name": "minicloud",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate": "turbo run generate",
    "openapi:validate": "pnpm --filter @minicloud/openapi validate",
    "openapi:generate": "pnpm --filter @minicloud/openapi generate"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
