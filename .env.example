# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
CONSOLE_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=minicloud
POSTGRES_USER=minicloud
POSTGRES_PASSWORD=minicloud_dev_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minicloud
MINIO_SECRET_KEY=minicloud_dev_secret

# Observability
OTEL_SERVICE_NAME=minicloud-api
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
